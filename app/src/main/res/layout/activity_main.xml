<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FICHA DE PEDIDO"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E5E4E"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen de su pedido"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <!-- FECHA DE EMISIÓN -->
        <TextView style="@style/LabelText" android:text="Fecha de emisión" />
        <EditText
            android:id="@+id/etFechaEmision"
            style="@style/InputField"
            android:focusable="false"
            android:hint="Seleccionar fecha" />

        <!-- NOMBRE -->
        <TextView style="@style/LabelText" android:text="Nombre" />
        <EditText
            android:id="@+id/etNombre"
            style="@style/InputField"
            android:inputType="textPersonName"
            android:hint="Nombre del cliente" />

        <!-- TELÉFONOS -->
        <TextView style="@style/LabelText" android:text="Teléfonos" />
        <EditText
            android:id="@+id/etTelefonos"
            style="@style/InputField"
            android:inputType="phone"
            android:hint="Ej. 809-000-0000" />

        <!-- LOCALIZADO -->
        <TextView style="@style/LabelText" android:text="Localizado" />
        <EditText
            android:id="@+id/etLocalizado"
            style="@style/InputField"
            android:inputType="textPostalAddress"
            android:hint="Dirección / sector" />

        <!-- ARTÍCULOS -->
        <TextView style="@style/LabelText" android:text="Artículos" />
        <EditText
            android:id="@+id/etArticulos"
            style="@style/InputField"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:hint="Artículos del pedido" />

        <!-- COLOR -->
        <TextView style="@style/LabelText" android:text="Color" />
        <EditText
            android:id="@+id/etColor"
            style="@style/InputField"
            android:inputType="text"
            android:hint="Color" />

        <!-- PRECIO -->
        <TextView style="@style/LabelText" android:text="Precio" />
        <EditText
            android:id="@+id/etPrecio"
            style="@style/InputField"
            android:inputType="numberDecimal"
            android:hint="RD$" />

        <!-- FECHA DE ENTREGA -->
        <TextView style="@style/LabelText" android:text="Fecha de entrega" />
        <EditText
            android:id="@+id/etFechaEntrega"
            style="@style/InputField"
            android:focusable="false"
            android:hint="Seleccionar fecha" />

        <!-- NOTA -->
        <TextView style="@style/LabelText" android:text="Nota" />
        <EditText
            android:id="@+id/etNota"
            style="@style/InputField"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:hint="Nota (opcional)" />

        <!-- VENDEDOR/A -->
        <TextView style="@style/LabelText" android:text="Vendedor/a" />
        <EditText
            android:id="@+id/etVendedor"
            style="@style/InputField"
            android:inputType="textPersonName"
            android:text="Jose Manuel Santillan" />

        <Button
            android:id="@+id/btnGenerarPdf"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Generar PDF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#2E5E4E"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="13sp"
            android:textColor="#555555"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
